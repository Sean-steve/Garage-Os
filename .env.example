# Garage OS Canonical Platform Environment Configuration

# Core Application
APP_ENV="development"
APP_NAME="Garage OS"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api/v1"
PORT="3000"

# Database Configuration (GAR-033)
DATABASE_URL="file:./data/garage_os.db"
DATABASE_POOL_MIN="1"
DATABASE_POOL_MAX="10"

# Observability & Logging (GAR-045)
LOG_LEVEL="info"
ENABLE_STRUCTURED_LOGS="true"
ENABLE_METRICS="true"

# Storage Configuration (GAR-038)
OBJECT_STORAGE_PROVIDER="local"
OBJECT_STORAGE_BUCKET="garage-os-media"
OBJECT_STORAGE_LOCAL_PATH="./data/storage"

# Security & CORS (GAR-039)
CORS_ALLOWED_ORIGINS="*"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
IDEMPOTENCY_RETENTION_HOURS="24"
ALLOW_DEV_ACTOR_HEADERS="false"

# Identity & Auth Placeholders (GAR-003)
JWT_SECRET="dev-insecure-secret-replace-in-production"
SESSION_TTL_SECONDS="86400"
TRUSTED_CONTACT_TOKEN_SECRET=""
TRUSTED_CONTACT_TOKEN_TTL_MINUTES="720"

# Event & Worker Configuration (GAR-035 / GAR-036)
OUTBOX_POLL_INTERVAL_MS="5000"
WORKER_CONCURRENCY="4"
JOB_MAX_RETRIES="5"

# Integration Placeholders (Adapters)
PAYMENT_GATEWAY_ADAPTER="mock-sandbox"
MESSAGING_ADAPTER="mock-sandbox"
MAPS_GEO_ADAPTER="mock-sandbox"
OBD_TELEMETRY_ADAPTER="mock-sandbox"

# GEMINI_API_KEY: Required for server-side AI vehicle intelligence (GAR-028/GAR-041)
GEMINI_API_KEY=""

